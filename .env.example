POSTGRES_DB=pharma
POSTGRES_USER=pharma_admin
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pharma_admin:local_dev_only@localhost:5433/pharma

# Local FastAPI runtime identities. Replace every value outside local development.
PHARMA_DB_AUTH_USER=pharma_runtime_auth
PHARMA_DB_AUTH_PASSWORD=local_auth_only
PHARMA_DB_LIMITED_USER=pharma_runtime_limited
PHARMA_DB_LIMITED_PASSWORD=local_limited_only
PHARMA_DB_EXEC_USER=pharma_runtime_exec
PHARMA_DB_EXEC_PASSWORD=local_exec_only
PHARMA_SESSION_SECRET=local-development-session-secret-change-me
PHARMA_COOKIE_SECURE=false
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Agent configuration. Obtain the API key separately; never commit it.
PHARMA_OPENAI_API_KEY=
PHARMA_OPENAI_MODEL=gpt-5.6-sol
PHARMA_OPENAI_REASONING_EFFORT=medium
PHARMA_AGENT_MAX_REPAIRS=1
PHARMA_AGENT_MAX_ROWS=100
