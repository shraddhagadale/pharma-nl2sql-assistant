aws_region  = "us-east-1"
environment = "demo"

# Narrow this to your IP address during infrastructure review when practical.
allowed_http_cidrs = ["0.0.0.0/0"]

ec2_instance_type = "t3.small"
db_instance_class = "db.t4g.micro"

# Demo defaults favor easy teardown. Production should reverse both settings.
deletion_protection = false
skip_final_snapshot = true
